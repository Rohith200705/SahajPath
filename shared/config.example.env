# =============================================================================
#  ACCESSIBLE LEARNING PLATFORM — CENTRAL CONFIG (SINGLE SOURCE OF TRUTH)
# =============================================================================
#  HOW TO USE:
#   1. Copy this file to ".env"  (cp config.example.env .env)
#   2. Fill in the real values (API keys, Mongo connection string).
#   3. NEVER commit the real ".env" to git. Only commit THIS example file.
#   4. Both the Node backend and the Python AI service read from here.
#
#  FRONTEND CREW: the only thing you need is NODE_BASE_URL below.
#                 All your API calls go to that URL. Nothing else.
# =============================================================================


# -----------------------------------------------------------------------------
#  SERVICE URLS & PORTS  (how the services find each other)
# -----------------------------------------------------------------------------

# Node/Express backend — THIS is what the frontend calls.
NODE_PORT=5000
NODE_BASE_URL=http://localhost:5000

# Python FastAPI AI service — INTERNAL ONLY. Frontend must NOT call this.
# Node calls this URL to request AI work.
PYTHON_AI_PORT=8000
PYTHON_AI_URL=http://localhost:8000

# Frontend origin — used by Node for CORS (which sites may call the API).
FRONTEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
#  DATABASE  (MongoDB)
# -----------------------------------------------------------------------------
# Paste your MongoDB Atlas connection string here when you have it.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=PASTE_YOUR_MONGODB_CONNECTION_STRING_HERE
MONGODB_DB_NAME=accessible_learning


# -----------------------------------------------------------------------------
#  AI / ML PROVIDER KEYS  (used by the Python service only)
# -----------------------------------------------------------------------------

# --- Simplification + Chat (Groq — OpenAI-compatible, fast & free tier) ---
GROQ_API_KEY=PASTE_GROQ_API_KEY_HERE
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# --- Translation ---
# Option A: Google Translate API (needs key). Option B: IndicTrans2 (free, local, no key).
TRANSLATION_PROVIDER=indictrans2
GOOGLE_TRANSLATE_API_KEY=PASTE_GOOGLE_TRANSLATE_KEY_HERE_IF_USED

# --- Text-to-Speech ---
# gTTS is free and needs no key. ElevenLabs needs a key (better quality).
TTS_PROVIDER=gtts
ELEVENLABS_API_KEY=PASTE_ELEVENLABS_KEY_HERE_IF_USED


# -----------------------------------------------------------------------------
#  FILE STORAGE PATHS  (where uploads & generated audio live)
# -----------------------------------------------------------------------------
# Where incoming uploads (images, PDFs) are temporarily stored.
UPLOAD_DIR=./storage/uploads
# Where generated audio (MP3) files are written.
AUDIO_OUTPUT_DIR=./storage/audio
# Public URL path the frontend uses to fetch generated audio.
# Full URL = NODE_BASE_URL + AUDIO_PUBLIC_PATH + /<filename>.mp3
AUDIO_PUBLIC_PATH=/media/audio
# Max upload size in megabytes.
MAX_UPLOAD_MB=25


# -----------------------------------------------------------------------------
#  SUPPORTED LANGUAGES  (Indian regional focus)
# -----------------------------------------------------------------------------
# Comma-separated language codes the platform supports.
SUPPORTED_LANGUAGES=en,hi,ta,te,kn,ml,mr,bn,gu,pa
DEFAULT_OUTPUT_LANGUAGE=hi


# -----------------------------------------------------------------------------
#  SECURITY  (internal service-to-service trust)
# -----------------------------------------------------------------------------
# Shared secret: Node sends this header, Python checks it, so ONLY Node
# can call the AI service. Generate a long random string.
INTERNAL_API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# JWT secret for user auth sessions (Node).
JWT_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
